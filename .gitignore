# Logo previews (2026-09-24)
scripts/artifacts/brand-*.png

# 2026-09-25 (STATUS § 33) — raw read-only snapshot of the send log: customers'
# message texts. Regenerate with scripts/archive/gw-20260925-scan.mjs; the committed
# analysis is scripts/artifacts/gw-20260925-analysis.{md,json}.
scripts/artifacts/gw-20260925-scan.json

# 2026-09-26 (STATUS § 37 ج) — data backups before a cleanup (full Odoo / D1
# rows, message texts, numbers). Never committed.
backups/

# § 41 و — the full-day simulation: fake-backend runs and each run's local R2 / page images stay out of git
scripts/artifacts/s41-sim/s41-fake-*/
scripts/artifacts/s41-sim/*/r2/
scripts/artifacts/s41-sim/*/*.png

# § 43 — prod launch secrets (six values, mode 600). Never committed; deleted after the cutover.
.env.prod-launch

# § 50 (2026-10-01) — scripts/artifacts/ (run outputs and rollback snapshots): nothing new is
# committed from it. The files tracked before § 50 stay tracked; a new rollback snapshot lives on
# this disk only (copy it to backups/ or another disk when it matters).
scripts/artifacts/

# § 55.1 (2026-10-05) — the working copies Claude Code makes for its agents. .claude/settings.json and
# .claude/hooks/ ARE committed (the project's hook); the worktrees never are.
.claude/worktrees/
