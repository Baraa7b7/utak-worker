  "before": {
    "plain": {
      "x_sale_price": {
        "id": 20407,
        "compute": "for record in self:\n    cost = record.x_cost_price or 0.0\n    margin = record.x_margin_pct or 0.0\n    if cost > 0 and margin > 0:\n        c = int(cost * 100 + 0.5)\n        m = int(margin * 100 + 0.5)\n        record['x_sale_price'] = ((c * (10000 + m) + 5000) // 10000) / 100.0\n    else:\n        record['x_sale_price'] = 0.0",
        "depends": "x_cost_price,x_margin_pct",
        "readonly": true
      },
      "x_excluded": {
        "id": 20409,
        "compute": "for record in self:\n    record['x_excluded'] = not ((record.x_margin_pct or 0.0) > 0)",
        "depends": "x_margin_pct",
        "readonly": true
      },
      "x_blocked": {
        "id": 20411,
        "compute": "for record in self:\n    edited = abs((record.x_cost_price or 0.0) - (record.x_source_price or 0.0)) >= 0.005\n    record['x_blocked'] = bool(record.x_is_outlier and not record.x_outlier_ok and not edited and (record.x_margin_pct or 0.0) > 0)",
        "depends": "x_is_outlier,x_outlier_ok,x_cost_price,x_source_price,x_margin_pct",
        "readonly": true
      }
    },
    "labels": {
      "x_price_day_line.x_supplier_id": {
        "id": 20389,
        "field_description": "المورد"
      },
      "x_price_day_line.x_offers": {
        "id": 20405,
        "field_description": "عروض الموردين"
