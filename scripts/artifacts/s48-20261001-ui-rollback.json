      "openDay": {
        "id": 1032,
        "code": "Day = env['x_price_day']\ntoday = (datetime.datetime.now() + datetime.timedelta(hours=3)).date()\nrec = Day.search([('x_date', '=', today), ('x_utak_simulation', '=', False)], order='id', limit=1)\nif not rec:\n    rec = Day.search([('x_date', '<', today), ('x_utak_simulation', '=', False)], order='x_date desc, id desc', limit=1)\nif not rec:\n    raise UserError('لا يوجد سجل «أسعار اليوم» بعد.')\naction = {'type': 'ir.actions.act_window', 'name': 'لوحة التسعير', 'res_model': 'x_price_day', 'res_id': rec.id, 'view_mode': 'form', 'views': [[2871, 'form']], 'target': 'current'}"
